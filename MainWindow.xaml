<Window x:Class="WpfLab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WpfLab2.Views"
        Title="ЛР2 — Привязки и команды"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PrimaryBrush}"
                Padding="20,14">
            <TextBlock Text="Лабораторная работа №2 — Привязки и команды"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"/>
        </Border>

        <TabControl Margin="12">
            <TabItem Header="Привязка по умолчанию">
                <views:DefaultBindingView/>
            </TabItem>
            <TabItem Header="Двухсторонняя привязка">
                <views:TwoWayBindingView/>
            </TabItem>
            <TabItem Header="Одноразовая привязка">
                <views:OneTimeBindingView/>
            </TabItem>
            <TabItem Header="Односторонние привязки">
                <views:OneWayBindingView/>
            </TabItem>
            <TabItem Header="Триггеры">
                <views:TriggersView/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
