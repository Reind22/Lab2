<UserControl x:Class="WpfLab2.Views.TriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfLab2.ViewModels">
    <UserControl.DataContext>
        <vm:TriggersViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="Триггеры" Style="{StaticResource H1Text}"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Text="Property / Data / Event / Multi / MultiData триггеры."/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Property Trigger -->
                <GroupBox Header="Property Trigger (IsMouseOver)" Grid.Row="0" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Наведи мышь — цвет изменится."/>
                        <Border Padding="20" Margin="4" CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Hover me" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Data Trigger -->
                <GroupBox Header="Data Trigger (Person.IsActive)" Grid.Row="0" Grid.Column="1">
                    <StackPanel>
                        <CheckBox Content="Person.IsActive" IsChecked="{Binding Person.IsActive}"/>
                        <TextBlock Text="{Binding Person.Name}" FontSize="20" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Person.IsActive}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Event Trigger -->
                <GroupBox Header="Event Trigger (Loaded → Storyboard)" Grid.Row="1" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Появляется плавно при загрузке:"/>
                        <Border Padding="30" Margin="4" CornerRadius="8"
                                Background="{StaticResource PrimaryBrush}">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:1.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <TextBlock Text="Animated" Foreground="White"
                                       HorizontalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- MultiTrigger -->
                <GroupBox Header="MultiTrigger (IsMouseOver + IsEnabled)" Grid.Row="1" Grid.Column="1">
                    <StackPanel>
                        <CheckBox x:Name="EnableCb" Content="Enabled" IsChecked="True"/>
                        <Border Padding="20" Margin="4" CornerRadius="8"
                                IsEnabled="{Binding ElementName=EnableCb, Path=IsChecked}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Style.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsEnabled" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Hover (только если Enabled)" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- MultiDataTrigger -->
                <GroupBox Header="MultiDataTrigger (Age &gt; 18 AND IsActive)" Grid.Row="2" Grid.ColumnSpan="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Возраст:" Width="70"/>
                            <Slider Value="{Binding Person.Age}" Minimum="0" Maximum="80" Width="300"/>
                            <TextBlock Text="{Binding Person.Age}" Margin="8,4" Width="40"/>
                            <CheckBox Content="IsActive" IsChecked="{Binding Person.IsActive}" Margin="16,4"/>
                        </StackPanel>
                        <Border Padding="14" Margin="4" CornerRadius="8" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Person.IsActive}" Value="True"/>
                                                <Condition Binding="{Binding IsAdultAndActive}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="#FF22C55E"/>
                                            <Setter Property="Background" Value="#FFE8F9EF"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock>
                                <Run Text="Статус: "/>
                                <Run Text="{Binding Person.Name}" FontWeight="Bold"/>
                                <Run Text=", "/>
                                <Run Text="{Binding Person.Age}"/>
                                <Run Text=" лет"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
