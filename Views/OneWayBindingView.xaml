<UserControl x:Class="WpfLab2.Views.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfLab2.ViewModels">
    <UserControl.DataContext>
        <vm:OneWayBindingViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="Односторонние привязки (OneWay и OneWayToSource)" Style="{StaticResource H1Text}"/>
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Text="OneWay: источник → цель. OneWayToSource: цель → источник. Цель здесь не читает значение источника обратно."/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ: прямая OneWay ElementName -->
                <Border Style="{StaticResource ColumnCard}" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Прямая OneWay (ElementName)" Style="{StaticResource H2Text}"/>

                        <TextBlock Text="Slider → TextBlock (OneWay):"/>
                        <Slider x:Name="SrcSlider" Minimum="0" Maximum="100" Value="30"/>
                        <TextBlock Text="{Binding ElementName=SrcSlider, Path=Value, Mode=OneWay, StringFormat='Значение = {0:F0}'}"
                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>

                        <TextBlock Text="CheckBox → TextBlock (OneWay):" Margin="4,10,4,4"/>
                        <CheckBox x:Name="SrcCheck" Content="Включено" IsChecked="True"/>
                        <TextBlock Text="{Binding ElementName=SrcCheck, Path=IsChecked, Mode=OneWay, StringFormat='IsChecked = {0}'}"/>
                    </StackPanel>
                </Border>

                <!-- ПРАВАЯ: OneWay + OneWayToSource через VM -->
                <Border Style="{StaticResource ColumnCard}" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Через ViewModel" Style="{StaticResource H2Text}"/>

                        <TextBlock Text="OneWay: VM.Age → UI"/>
                        <Slider Value="{Binding Person.Age, Mode=OneWay}" IsEnabled="False"
                                Minimum="0" Maximum="100"/>
                        <TextBlock Text="{Binding Person.Age, Mode=OneWay, StringFormat='VM.Age = {0}'}"
                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        <Slider Value="{Binding Person.Age, Mode=TwoWay}" Minimum="0" Maximum="100"/>
                        <TextBlock Text="(этот слайдер меняет VM.Age, а верхний — только читает)"
                                   Style="{StaticResource CaptionText}"/>

                        <TextBlock Text="OneWayToSource: UI → VM.Email" Margin="4,14,4,4"/>
                        <TextBox Text="{Binding Person.Email, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="(в TextBox начально пусто: OneWayToSource не читает VM)"
                                   Style="{StaticResource CaptionText}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Показать VM.Email"
                                    Command="{Binding ShowEmailCommand}"
                                    Style="{StaticResource AccentButton}"/>
                            <Button Content="Сброс" Command="{Binding ResetCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
